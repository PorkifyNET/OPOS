#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#include "console.h"
#include "initramfs.h"
#include "keyboard.h"
#include "memory.h"
#include "mouse.h"
#include "power.h"
#include "timer.h"
#include "user.h"

#define DESKTOP_BUTTON_X 36
#define DESKTOP_BUTTON_Y 126
#define DESKTOP_BUTTON_WIDTH 300
#define DESKTOP_BUTTON_HEIGHT 58
#define DESKTOP_BUTTON_SPACING 76

struct desktop_button {
    const char *label;
    enum user_program program;
};

static const struct desktop_button buttons[] = {
    {"LINUX ELF TEST", USER_PROGRAM_MODULE_ELF},
    {"RING 3 DEMO", USER_PROGRAM_DEMO},
    {"OPEN TERMINAL", USER_PROGRAM_DEMO},
    {"SYSTEM INFO", USER_PROGRAM_DEMO},
};

static char terminal_line[64];
static size_t terminal_length;
static char terminal_output[64];
static uint8_t workspace_split_percent = 50;

static size_t append_decimal(char *buffer, size_t capacity, size_t offset,
                             uint64_t value);

static bool terminal_text_equals(const char *text, size_t length,
                                 const char *expected) {
    size_t i = 0;
    while (i < length && expected[i] != '\0' && text[i] == expected[i]) {
        i++;
    }
    return i == length && expected[i] == '\0';
}

static void terminal_set_output(const char *text) {
    size_t i = 0;
    while (text[i] != '\0' && i + 1 < sizeof(terminal_output)) {
        terminal_output[i] = text[i];
        i++;
    }
    terminal_output[i] = '\0';
}

static void terminal_set_uptime(void) {
    char digits[20];
    size_t count = 0;
    uint64_t ticks = timer_ticks();
    do {
        digits[count++] = '0' + ticks % 10;
        ticks /= 10;
    } while (ticks != 0 && count < sizeof(digits));

    const char prefix[] = "UPTIME TICKS: ";
    size_t output = 0;
    while (prefix[output] != '\0') {
        terminal_output[output] = prefix[output];
        output++;
    }
    while (count != 0 && output + 1 < sizeof(terminal_output)) {
        terminal_output[output++] = digits[--count];
    }
    terminal_output[output] = '\0';
}

static void draw_workspace_uptime(uint64_t x, uint64_t y, uint64_t width) {
    char uptime[48] = "UPTIME: ";
    append_decimal(uptime, sizeof(uptime), 8, timer_ticks() / 100);
    console_draw_rectangle(x + 8, y + 84, width - 16, 32, 28, 42, 67);
    console_draw_text(x + 16, y + 96, uptime, 230, 238, 255);
}

static void draw_workspace_info(uint64_t x, uint64_t y, uint64_t width,
                                uint64_t height, bool focused) {
    char memory[48] = "USABLE MEMORY: ";
    append_decimal(memory, sizeof(memory), 15,
                   memory_total_pages() * 4096 / (1024 * 1024));

    console_draw_rectangle(x, y, width, height, 28, 42, 67);
    console_draw_text(x + 16, y + 22, focused ? "SYSTEM INFO [FOCUSED]"
                                             : "SYSTEM INFO",
                      focused ? 120 : 151, focused ? 210 : 190, 235);
    console_draw_text(x + 16, y + 64, "OPOS X86-64", 230, 238, 255);
    draw_workspace_uptime(x, y, width);
    console_draw_text(x + 16, y + 128, memory, 230, 238, 255);
    console_draw_text(x + 16, y + 160, "PIT TIMER: 100 HZ", 151, 190, 235);
}

static void terminal_draw(bool tiled, bool terminal_focused) {
    uint64_t width = console_screen_width();
    uint64_t height = console_screen_height();
    console_clear();
    console_draw_rectangle(0, 0, width, height, 17, 26, 45);
    console_draw_rectangle(0, 0, width, 54, 29, 46, 76);
    console_draw_text(28, 20, tiled ? "OPOS TILED WORKSPACE" : "OPOS TERMINAL",
                      245, 248, 255);
    if (tiled) {
        uint64_t split = width * workspace_split_percent / 100;
        uint64_t left_x = 24;
        uint64_t pane_y = 78;
        uint64_t pane_height = height - 138;
        uint64_t left_width = split - 36;
        uint64_t right_x = split + 12;
        uint64_t right_width = width - right_x - 24;
        console_draw_rectangle(left_x, pane_y, left_width, pane_height,
                               12, 18, 32);
        console_draw_text(left_x + 16, pane_y + 22,
                          terminal_focused ? "TERMINAL [FOCUSED]" : "TERMINAL",
                          terminal_focused ? 120 : 151,
                          terminal_focused ? 210 : 190, 235);
        console_draw_text(left_x + 16, pane_y + 58,
                          "HELP LS CLEAR UPTIME ELF DEMO REBOOT SHUTDOWN EXIT",
                          151, 190, 235);
        console_draw_text(left_x + 16, pane_y + 96, terminal_output,
                          230, 238, 255);
        console_draw_text(left_x + 16, height - 90, "OPOS>", 120, 210, 170);
        console_draw_text(left_x + 76, height - 90, terminal_line,
                          240, 245, 255);
        draw_workspace_info(right_x, pane_y, right_width, pane_height,
                            !terminal_focused);
    } else {
        console_draw_rectangle(32, 90, width - 64, height - 160, 12, 18, 32);
        console_draw_text(52, 118, "HELP LS CLEAR UPTIME ELF DEMO REBOOT SHUTDOWN EXIT",
                          151, 190, 235);
        console_draw_text(52, 158, terminal_output, 230, 238, 255);
        console_draw_text(52, height - 90, "OPOS>", 120, 210, 170);
        console_draw_text(112, height - 90, terminal_line, 240, 245, 255);
    }
    console_draw_rectangle(0, height - 42, width, 42, 29, 46, 76);
    console_draw_text(24, height - 30,
                      tiled ? "TAB OR CLICK FOCUS  [ ] RESIZE  Q RETURNS"
                            : "ENTER RUNS COMMAND  Q RETURNS",
                      230, 238, 255);
    console_cursor_refresh();
}

static bool terminal_launch(enum user_program program) {
    uint64_t process_id;
    uint64_t exit_status;
    if (!user_process_run(program, &process_id, &exit_status)) {
        terminal_set_output("APPLICATION COULD NOT START");
        return false;
    }
    terminal_set_output(exit_status == 0 ? "APPLICATION EXITED WITH STATUS 0"
                                         : "APPLICATION EXITED WITH ERROR");
    return true;
}

static bool terminal_launch_path(const char *path, size_t path_length) {
    size_t path_start = path_length != 0 && path[0] == '/' ? 1 : 0;
    size_t archive_length = path_length - path_start;
    if (archive_length == 0 || archive_length > 127) {
        terminal_set_output("USAGE: RUN PATH");
        return true;
    }

    char archive_path[128];
    for (size_t i = 0; i < archive_length; i++) {
        archive_path[i] = path[path_start + i];
    }
    archive_path[archive_length] = '\0';
    struct initramfs_file file;
    if (!initramfs_find_file(archive_path, &file)) {
        terminal_set_output("APPLICATION FILE NOT FOUND");
        return true;
    }

    uint64_t process_id;
    uint64_t exit_status;
    if (!user_process_run_elf_path(file.data, file.size,
                                   path, path_length,
                                   &process_id, &exit_status)) {
        terminal_set_output("APPLICATION COULD NOT START");
        return false;
    }
    terminal_set_output(exit_status == 0 ? "APPLICATION EXITED WITH STATUS 0"
                                         : "APPLICATION EXITED WITH ERROR");
    return true;
}

static bool terminal_execute(void) {
    if (terminal_text_equals(terminal_line, terminal_length, "help")) {
        terminal_set_output("HELP LS CLEAR UPTIME ELF DEMO RUN [/]PATH REBOOT SHUTDOWN EXIT");
    } else if (terminal_text_equals(terminal_line, terminal_length, "ls")) {
        char output[sizeof(terminal_output)];
        size_t output_length = 0;
        output[0] = '\0';
        size_t count = initramfs_file_count();
        for (size_t i = 0; i < count; i++) {
            char path[128];
            size_t file_size;
            if (!initramfs_file_at(i, path, sizeof(path), &file_size)) {
                terminal_set_output("FILE LIST UNAVAILABLE");
                return true;
            }
            (void)file_size;
            size_t path_length = 0;
            while (path[path_length] != '\0') {
                path_length++;
            }
            bool first = output_length == 0;
            size_t prefix_length = first ? 1 : 2;
            if (prefix_length + path_length + output_length >= sizeof(output)) {
                terminal_set_output("FILE LIST TOO LONG");
                return true;
            }
            if (!first) {
                output[output_length++] = ' ';
            }
            output[output_length++] = '/';
            for (size_t j = 0; j < path_length; j++) {
                output[output_length++] = path[j];
            }
            output[output_length] = '\0';
        }
        terminal_set_output(output_length == 0 ? "NO FILES" : output);
    } else if (terminal_text_equals(terminal_line, terminal_length, "clear")) {
        terminal_set_output("");
    } else if (terminal_text_equals(terminal_line, terminal_length, "uptime")) {
        terminal_set_uptime();
    } else if (terminal_text_equals(terminal_line, terminal_length, "elf")) {
        return terminal_launch(USER_PROGRAM_MODULE_ELF);
    } else if (terminal_text_equals(terminal_line, terminal_length, "demo")) {
        return terminal_launch(USER_PROGRAM_DEMO);
    } else if (terminal_length > 4
               && terminal_text_equals(terminal_line, 4, "run ")) {
        return terminal_launch_path(terminal_line + 4, terminal_length - 4);
    } else if (terminal_text_equals(terminal_line, terminal_length, "reboot")) {
        power_reboot();
    } else if (terminal_text_equals(terminal_line, terminal_length, "shutdown")) {
        if (!power_shutdown()) {
            terminal_set_output("ACPI SHUTDOWN UNAVAILABLE");
        }
    } else if (terminal_text_equals(terminal_line, terminal_length, "exit")) {
        return false;
    } else if (terminal_length == 0) {
        return true;
    } else {
        terminal_set_output("UNKNOWN COMMAND - TYPE HELP");
    }
    return true;
}

static bool terminal_run(bool tiled) {
    terminal_length = 0;
    terminal_line[0] = '\0';
    terminal_set_output("WELCOME - TYPE HELP");
    bool terminal_focused = true;
    uint64_t displayed_uptime = timer_ticks() / 100;
    struct mouse_state mouse_state = {0};
    bool have_mouse = mouse_read_state(&mouse_state);
    uint8_t previous_buttons = have_mouse ? mouse_state.buttons : 0;
    terminal_draw(tiled, terminal_focused);

    for (;;) {
        bool redraw = false;
        char character;
        while (keyboard_read_character(&character)) {
            if (tiled && character == '\t') {
                terminal_focused = !terminal_focused;
                redraw = true;
                continue;
            }
            /*
             * Shortcut keys only apply while no command is being typed, so
             * every printable character (including q, [ and ]) can be entered
             * into a command line.
             */
            bool shortcuts = !terminal_focused || terminal_length == 0;
            if (tiled && shortcuts && (character == '[' || character == ']')) {
                if (character == '[' && workspace_split_percent > 25) {
                    workspace_split_percent -= 5;
                } else if (character == ']' && workspace_split_percent < 75) {
                    workspace_split_percent += 5;
                }
                redraw = true;
                continue;
            }
            if (shortcuts && (character == 'q' || character == 'Q')) {
                return true;
            }
            if (tiled && !terminal_focused) {
                continue;
            }
            if (character == '\b') {
                if (terminal_length != 0) {
                    terminal_line[--terminal_length] = '\0';
                    redraw = true;
                }
            } else if (character == '\n') {
                bool keep_open = terminal_execute();
                terminal_length = 0;
                terminal_line[0] = '\0';
                if (!keep_open) {
                    return false;
                }
                redraw = true;
            } else if (character >= ' ' && character <= '~'
                       && terminal_length + 1 < sizeof(terminal_line)) {
                terminal_line[terminal_length++] = character;
                terminal_line[terminal_length] = '\0';
                redraw = true;
            }
        }

        if (tiled) {
            have_mouse = mouse_read_state(&mouse_state);
            if (have_mouse && (mouse_state.buttons & 1) != 0
                && (previous_buttons & 1) == 0
                && mouse_state.y >= 78
                && (uint64_t)mouse_state.y < console_screen_height() - 60) {
                uint64_t split =
                    console_screen_width() * workspace_split_percent / 100;
                if (mouse_state.x >= 24
                    && (uint64_t)mouse_state.x < split - 12) {
                    terminal_focused = true;
                    redraw = true;
                } else if ((uint64_t)mouse_state.x >= split + 12
                           && (uint64_t)mouse_state.x
                               < console_screen_width() - 24) {
                    terminal_focused = false;
                    redraw = true;
                }
            }
            previous_buttons = have_mouse ? mouse_state.buttons : 0;
        }

        uint64_t current_uptime = timer_ticks() / 100;
        if (tiled && current_uptime != displayed_uptime) {
            displayed_uptime = current_uptime;
            uint64_t split =
                console_screen_width() * workspace_split_percent / 100;
            uint64_t right_x = split + 12;
            draw_workspace_uptime(right_x, 78,
                                  console_screen_width() - right_x - 24);
        }
        if (redraw) {
            terminal_draw(tiled, terminal_focused);
        }
        console_cursor_refresh();
        __asm__ volatile ("hlt" : : : "memory");
    }
}

static void draw_button(size_t index, uint8_t red, uint8_t green, uint8_t blue) {
    uint64_t y = DESKTOP_BUTTON_Y + index * DESKTOP_BUTTON_SPACING;
    console_draw_rectangle(DESKTOP_BUTTON_X, y, DESKTOP_BUTTON_WIDTH,
                           DESKTOP_BUTTON_HEIGHT, red, green, blue);
    console_draw_text(DESKTOP_BUTTON_X + 16, y + 22, buttons[index].label,
                      240, 245, 255);
}

static void draw_desktop(const char *status) {
    uint64_t width = console_screen_width();
    uint64_t height = console_screen_height();
    console_clear();
    console_draw_rectangle(0, 0, width, height, 17, 26, 45);
    console_draw_rectangle(0, 0, width, 54, 29, 46, 76);
    console_draw_text(28, 20, "OPOS DESKTOP", 245, 248, 255);
    console_draw_text(36, 82, "APPLICATIONS", 151, 190, 235);

    for (size_t i = 0; i < sizeof(buttons) / sizeof(buttons[0]); i++) {
        draw_button(i, 43, 66, 101);
    }

    if (width > 760) {
        uint64_t panel_x = 380;
        uint64_t panel_width = width - panel_x - 36;
        console_draw_rectangle(panel_x, 126, panel_width, 260, 28, 42, 67);
        console_draw_text(panel_x + 22, 152, "WELCOME TO OPOS", 245, 248, 255);
        console_draw_text(panel_x + 22, 190, "X86 64 DESKTOP", 151, 190, 235);
        console_draw_text(panel_x + 22, 228, "LINUX ABI TESTS READY", 151, 190, 235);
        console_draw_text(panel_x + 22, 266, "WINDOWS SUPPORT PLANNED", 151, 190, 235);
        console_draw_text(panel_x + 22, 304, "CLICK OR PRESS 1-4", 151, 190, 235);
    }

    console_draw_rectangle(0, height - 42, width, 42, 29, 46, 76);
    console_draw_text(24, height - 30, "1-4 SELECT  T TILED WORKSPACE  Q EXIT", 230, 238, 255);
    if (status != NULL) {
        console_draw_text(36, height - 66, status, 240, 205, 120);
    }
}

static bool button_contains(const struct mouse_state *state, size_t index) {
    uint64_t y = DESKTOP_BUTTON_Y + index * DESKTOP_BUTTON_SPACING;
    return state->x >= DESKTOP_BUTTON_X
        && (uint64_t)state->x < DESKTOP_BUTTON_X + DESKTOP_BUTTON_WIDTH
        && state->y >= (int32_t)y
        && (uint64_t)state->y < y + DESKTOP_BUTTON_HEIGHT;
}

static size_t append_decimal(char *buffer, size_t capacity, size_t offset,
                             uint64_t value) {
    char digits[20];
    size_t count = 0;
    do {
        digits[count++] = '0' + value % 10;
        value /= 10;
    } while (value != 0 && count < sizeof(digits));

    while (count != 0 && offset + 1 < capacity) {
        buffer[offset++] = digits[--count];
    }
    buffer[offset] = '\0';
    return offset;
}

static void system_info_draw_uptime(uint64_t uptime_seconds) {
    char uptime[48] = "UPTIME: ";
    append_decimal(uptime, sizeof(uptime), 8, uptime_seconds);
    size_t uptime_length = 0;
    while (uptime[uptime_length] != '\0') {
        uptime_length++;
    }
    const char uptime_suffix[] = " SECONDS";
    for (size_t i = 0; uptime_suffix[i] != '\0'
         && uptime_length + 1 < sizeof(uptime); i++) {
        uptime[uptime_length++] = uptime_suffix[i];
    }
    uptime[uptime_length] = '\0';

    console_draw_rectangle(56, 178, console_screen_width() - 96, 32,
                           28, 42, 67);
    console_draw_text(64, 184, uptime, 230, 238, 255);
}

static void system_info_draw(uint64_t usable_memory_mb) {
    uint64_t width = console_screen_width();
    uint64_t height = console_screen_height();
    char memory[48] = "USABLE MEMORY: ";
    append_decimal(memory, sizeof(memory), 15, usable_memory_mb);
    size_t memory_length = 0;
    while (memory[memory_length] != '\0') {
        memory_length++;
    }
    const char memory_suffix[] = " MB";
    for (size_t i = 0; memory_suffix[i] != '\0'
         && memory_length + 1 < sizeof(memory); i++) {
        memory[memory_length++] = memory_suffix[i];
    }
    memory[memory_length] = '\0';

    console_clear();
    console_draw_rectangle(0, 0, width, height, 17, 26, 45);
    console_draw_rectangle(0, 0, width, 54, 29, 46, 76);
    console_draw_text(28, 20, "SYSTEM INFORMATION", 245, 248, 255);
    console_draw_rectangle(36, 104, width - 72, 220, 28, 42, 67);
    console_draw_text(64, 136, "OPOS X86 64", 151, 190, 235);
    console_draw_text(64, 224, memory, 230, 238, 255);
    console_draw_text(64, 264, "PIT TIMER AT 100 HZ", 151, 190, 235);
    console_draw_rectangle(36, height - 108, 190, 52, 43, 66, 101);
    console_draw_text(54, height - 88, "BACK TO DESKTOP", 240, 245, 255);
    console_draw_rectangle(0, height - 42, width, 42, 29, 46, 76);
    console_draw_text(24, height - 30, "Q RETURNS TO DESKTOP", 230, 238, 255);
    console_cursor_refresh();
}

static void system_info_run(void) {
    const uint64_t usable_memory_mb =
        memory_total_pages() * 4096 / (1024 * 1024);
    uint64_t displayed_seconds = UINT64_MAX;
    struct mouse_state state;
    bool have_mouse = mouse_read_state(&state);
    uint8_t previous_buttons = have_mouse ? state.buttons : 0;

    for (;;) {
        uint64_t current_seconds = timer_ticks() / 100;
        if (current_seconds != displayed_seconds) {
            if (displayed_seconds == UINT64_MAX) {
                system_info_draw(usable_memory_mb);
            }
            system_info_draw_uptime(current_seconds);
            displayed_seconds = current_seconds;
        }

        char character;
        bool return_to_desktop = false;
        while (keyboard_read_character(&character)) {
            if (character == 'q' || character == 'Q') {
                return_to_desktop = true;
            }
        }

        have_mouse = mouse_read_state(&state);
        if (have_mouse && (state.buttons & 1) != 0
            && (previous_buttons & 1) == 0
            && state.x >= 36 && state.x < 226
            && state.y >= (int32_t)(console_screen_height() - 108)
            && state.y < (int32_t)(console_screen_height() - 56)) {
            return_to_desktop = true;
        }
        previous_buttons = have_mouse ? state.buttons : 0;

        if (return_to_desktop) {
            return;
        }
        console_cursor_refresh();
        __asm__ volatile ("hlt" : : : "memory");
    }
}

static bool launch_program(enum user_program program) {
    uint64_t process_id;
    uint64_t exit_status;
    if (!user_process_run(program, &process_id, &exit_status)) {
        return false;
    }
    (void)process_id;
    return exit_status == 0;
}

void desktop_run(void) {
    if (console_screen_width() < 400 || console_screen_height() < 420) {
        console_write_string("Desktop requires a 400x420 framebuffer.\n");
        return;
    }

    const char *status = NULL;
    struct mouse_state mouse_state = {0};
    bool have_mouse = mouse_read_state(&mouse_state);
    uint8_t previous_buttons = have_mouse ? mouse_state.buttons : 0;
    draw_desktop(NULL);

    for (;;) {
        console_cursor_refresh();
        int selection = -1;
        bool open_tiled_workspace = false;
        char character;
        while (keyboard_read_character(&character)) {
            if (character == 'q' || character == 'Q') {
                console_clear();
                return;
            }
            if (character == 't' || character == 'T') {
                open_tiled_workspace = true;
            }
            if (character >= '1' && character <= '4') {
                selection = character - '1';
            }
        }

        have_mouse = mouse_read_state(&mouse_state);
        if (selection < 0 && have_mouse && (mouse_state.buttons & 1) != 0
            && (previous_buttons & 1) == 0) {
            for (size_t i = 0; i < sizeof(buttons) / sizeof(buttons[0]); i++) {
                if (button_contains(&mouse_state, i)) {
                    selection = (int)i;
                    break;
                }
            }
        }
        previous_buttons = have_mouse ? mouse_state.buttons : 0;

        if (open_tiled_workspace) {
            (void)terminal_run(true);
            status = "TILED WORKSPACE CLOSED";
            draw_desktop(status);
        } else if (selection == 2) {
            bool keep_desktop = terminal_run(false);
            if (!keep_desktop) {
                console_clear();
                return;
            }
            status = "TERMINAL CLOSED";
            draw_desktop(status);
        }
        if (selection == 3) {
            system_info_run();
            status = "SYSTEM INFO CLOSED";
            draw_desktop(status);
        } else if (selection == 0 || selection == 1) {
            bool started = launch_program(buttons[selection].program);
            status = started ? "APPLICATION EXITED - SEE CONSOLE"
                             : "APPLICATION COULD NOT START";
            draw_desktop(status);
        }

        if (selection < 0) {
            __asm__ volatile ("hlt" : : : "memory");
        }
    }
}
